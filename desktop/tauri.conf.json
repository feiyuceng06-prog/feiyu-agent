{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Feiyu",
  "version": "0.67.1",
  "identifier": "com.feiyuz.feiyu",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "Feiyu",
        "width": 1240,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#ffffff",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32.png",
      "icons/128.png",
      "icons/icon.png"
    ]
  }
}
